model Review {
  id            String  @id @default(uuid())
  customerId    String  @map("customer_id")
  gearItemId    String  @map("gear_item_id")
  rentalOrderId String  @map("rental_order_id")
  rating        Int
  comment       String?

  customer    User        @relation(fields: [customerId], references: [id])
  gearItem    GearItem    @relation(fields: [gearItemId], references: [id])
  rentalOrder RentalOrder @relation(fields: [rentalOrderId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([customerId, gearItemId, rentalOrderId])
  @@index([gearItemId])
  @@index([rentalOrderId])
  @@map("reviews")
}
