{
  "info": {
    "name": "rental",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "create rental order",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{api}}/api/rentals",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{CustomerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startDate\": \"2026-07-10\",\n  \"endDate\": \"2026-07-12\",\n  \"items\": [\n    {\n      \"gearItemId\": \"{{gearItemId}}\",\n      \"quantity\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json?.data?.id) pm.environment.set('rentalOrderId', json.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "get my rental orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/rentals",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{CustomerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "get rental order details",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/rentals/{{rentalOrderId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{CustomerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    }
  ]
}