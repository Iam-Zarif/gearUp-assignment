{
  "info": {
    "name": "payment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "create payment session",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{api}}/api/payments/create",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{CustomerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rentalOrderId\": \"{{rentalOrderId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json?.data?.sessionId) pm.environment.set('sessionId', json.data.sessionId);",
              "if (json?.data?.payment?.id) pm.environment.set('paymentId', json.data.payment.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "confirm payment",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{api}}/api/payments/confirm",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{CustomerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "get payment history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/payments",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{CustomerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "get payment details",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/payments/{{paymentId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{CustomerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "payment success callback",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/payments/success?session_id={{sessionId}}"
      },
      "response": []
    },
    {
      "name": "payment cancel callback",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/payments/cancel"
      },
      "response": []
    }
  ]
}