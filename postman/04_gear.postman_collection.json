{
  "info": {
    "name": "gear",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "create gear",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{api}}/api/provider/gear",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ProviderToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"name\": \"Adjustable Dumbbell Set\",\n  \"brand\": \"Bowflex\",\n  \"description\": \"Adjustable dumbbell set for home fitness training\",\n  \"pricePerDay\": 350,\n  \"stockQuantity\": 5,\n  \"availableQuantity\": 5,\n  \"imageUrl\": \"https://example.com/dumbbell.jpg\",\n  \"specifications\": {\n    \"weightRange\": \"5kg-25kg\",\n    \"material\": \"Steel\",\n    \"condition\": \"Good\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json?.data?.id) pm.environment.set('gearItemId', json.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "get all gear",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/gear"
      },
      "response": []
    },
    {
      "name": "get gear details",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/gear/{{gearItemId}}"
      },
      "response": []
    },
    {
      "name": "update gear",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{api}}/api/provider/gear/{{gearItemId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ProviderToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Adjustable Dumbbell Set\",\n  \"pricePerDay\": 400,\n  \"availableQuantity\": 4,\n  \"status\": \"AVAILABLE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "delete gear",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{api}}/api/provider/gear/{{gearItemId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ProviderToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    }
  ]
}