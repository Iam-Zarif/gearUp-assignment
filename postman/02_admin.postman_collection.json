        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{AdminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "get all rental orders",
      "request": {
        "method": "GET",
