{
  "info": {
    "name": "admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "get all users",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/admin/users",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{AdminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "update user status",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{api}}/api/admin/users/{{userId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{AdminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"SUSPENDED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "activate user",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{api}}/api/admin/users/{{userId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{AdminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
