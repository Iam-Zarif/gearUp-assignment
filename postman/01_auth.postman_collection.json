  },
  "item": [
    {
      "name": "register customer",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{api}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Customer One\",\n  \"email\": \"customer.new@gearup.com\",\n  \"password\": \"123456\",\n  \"phone\": \"01700000000\",\n  \"address\": \"Dhaka\",\n  \"profilePhoto\": \"https://example.com/customer.jpg\",\n  \"role\": \"CUSTOMER\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "register provider",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{api}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Provider One\",\n  \"email\": \"provider.new@gearup.com\",\n  \"password\": \"123456\",\n  \"phone\": \"01800000000\",\n  \"address\": \"Dhaka\",\n  \"profilePhoto\": \"https://example.com/provider.jpg\",\n  \"role\": \"PROVIDER\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
