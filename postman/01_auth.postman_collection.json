    {
      "name": "get profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/auth/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{CustomerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "update profile",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{api}}/api/auth/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{CustomerToken}}",
              "type": "string"
            }
          ]
        },
