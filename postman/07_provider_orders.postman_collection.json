{
  "info": {
    "name": "provider orders",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "get provider incoming orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/provider/orders",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ProviderToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "confirm rental order",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{api}}/api/provider/orders/{{rentalOrderId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ProviderToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CONFIRMED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "mark order picked up",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{api}}/api/provider/orders/{{rentalOrderId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ProviderToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"PICKED_UP\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "mark order returned",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{api}}/api/provider/orders/{{rentalOrderId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ProviderToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"RETURNED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "cancel rental order",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{api}}/api/provider/orders/{{rentalOrderId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ProviderToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"CANCELLED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ]
}