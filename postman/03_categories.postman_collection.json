{
  "info": {
    "name": "categories",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "get all categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/categories"
      },
      "response": []
    },
    {
      "name": "create category",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{api}}/api/categories",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{AdminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cycling\",\n  \"description\": \"Bicycles, helmets, gloves, and cycling accessories\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json?.data?.id) pm.environment.set('categoryId', json.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "update category",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{api}}/api/categories/{{categoryId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{AdminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cycling & Bikes\",\n  \"description\": \"Updated bicycles and cycling accessories\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "delete category",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{api}}/api/categories/{{categoryId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{AdminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    }
  ]
}