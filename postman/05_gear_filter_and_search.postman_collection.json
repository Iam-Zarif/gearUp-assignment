{
  "info": {
    "name": "gear filter and search",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "search by keyword",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/gear?searchTerm=dumbbell"
      },
      "response": []
    },
    {
      "name": "filter by brand",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/gear?brand=Bowflex"
      },
      "response": []
    },
    {
      "name": "filter by category name",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/gear?category=Fitness"
      },
      "response": []
    },
    {
      "name": "filter by min and max price",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/gear?minPrice=100&maxPrice=500"
      },
      "response": []
    },
    {
      "name": "filter by availability",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/gear?availability=available"
      },
      "response": []
    },
    {
      "name": "pagination and sorting",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/gear?page=1&limit=5&sortBy=pricePerDay&sortOrder=asc"
      },
      "response": []
    }
