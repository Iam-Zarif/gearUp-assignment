{
  "info": {
    "name": "review",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "create review",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{api}}/api/reviews",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{CustomerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gearItemId\": \"{{gearItemId}}\",\n  \"rentalOrderId\": \"{{rentalOrderId}}\",\n  \"rating\": 5,\n  \"comment\": \"Great equipment, clean and easy to use.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json?.data?.id) pm.environment.set('reviewId', json.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "get all reviews",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/reviews"
      },
      "response": []
    },
    {
      "name": "get reviews by gear",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/reviews?gearItemId={{gearItemId}}"
      },
      "response": []
    },
    {
      "name": "get review details",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{api}}/api/reviews/{{reviewId}}"
      },
      "response": []
    },
    {
      "name": "edit review",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{api}}/api/reviews/{{reviewId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{CustomerToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 4,\n  \"comment\": \"Good equipment, but delivery could be faster.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "delete review",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{api}}/api/reviews/{{reviewId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{CustomerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": []
    }
  ]
}